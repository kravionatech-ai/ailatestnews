# ============================================
# AI Latest News (ailatestnews.in) - Environment
# ============================================

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/ailatestnews-dev
# Production: mongodb+srv://user:pass@cluster.mongodb.net/ailatestnews

# --- Authentication (Auth.js) ---
AUTH_SECRET=development_secret_key_at_least_32_characters_long_123456
AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary (Media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=newsletter@ailatestnews.in

# --- Cache / Rate Limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI Chatbot (Anthropic Claude API) ---
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-3-5-sonnet-20241022
CHATBOT_MAX_TOKENS=800
CHATBOT_ENABLED=true
CHATBOT_DAILY_LIMIT=500

# --- Public Variables ---
# Development: http://localhost:3000 | Production: https://ailatestnews.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=AI Latest News
NEXT_PUBLIC_GA_ID=

# --- SEO ---
INDEXNOW_KEY=
NODE_ENV=development
