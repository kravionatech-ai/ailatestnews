# ============================================
# Kraviona AI News (www.kraviona.site) - Environment
# ============================================

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/ailatestnews-dev
# Production: mongodb+srv://user:pass@cluster.mongodb.net/ailatestnews

# --- Authentication (Auth.js) ---
AUTH_SECRET=development_secret_key_at_least_32_characters_long_123456
AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary (Media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=kravionatech@gmail.com

# --- Cache / Rate Limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI Chatbot (Anthropic Claude API) ---
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-3-5-sonnet-20241022
CHATBOT_MAX_TOKENS=800
CHATBOT_ENABLED=true
CHATBOT_DAILY_LIMIT=500

# --- Public Domain & SEO Configuration ---
# Canonical primary domain used for SEO metadata, canonicals, sitemaps, and RSS feeds.
# Future migration (e.g. kraviona.site -> ailatestnews.in): update NEXT_PUBLIC_SITE_URL and append old hosts to NEXT_PUBLIC_LEGACY_DOMAINS.
NEXT_PUBLIC_SITE_URL=https://www.kraviona.site
NEXT_PUBLIC_LOCAL_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LEGACY_DOMAINS=ainews.kraviona.com
NEXT_PUBLIC_SITE_NAME=Kraviona AI News

# --- Domain Redirects (Gated until target domain DNS & SSL are verified on Vercel) ---
ENABLE_DOMAIN_REDIRECTS=false
REDIRECT_SOURCE_DOMAINS=ainews.kraviona.com,www.ainews.kraviona.com

# --- Google Search Console Verification & Analytics ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=-XV8p9zE9MYruAbDWo-gSDEYRFLrSB200khCkukUysg
NEXT_PUBLIC_GTM_ID=GTM-5Q53H625
NEXT_PUBLIC_GA_ID=G-RC5GPJKKW2

# --- SEO ---
INDEXNOW_KEY=
NODE_ENV=development
